    given-names: Mohini Mohan
    affiliation: Indian Institute of Technology Jodhpur
    orcid: "https://orcid.org/0009-0007-3475-8230"
repository-code: "https://github.com/g25ait1091-droid/e-inv-camera-provenance"
url: "https://github.com/g25ait1091-droid/e-inv-camera-provenance"
license: MIT
